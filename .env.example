# Copy this file to .env.local. Restart the dev server after changing any values.
# Public website URL: use http://localhost:3000 locally; https://student.cleanbrandagency.com when deployed.
NEXT_PUBLIC_APP_URL=https://student.cleanbrandagency.com
NEXT_PUBLIC_SITE_URL=https://student.cleanbrandagency.com

# Supabase Dashboard > Project > Connect
# The URL and publishable key are safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER SECRET — never prefix this with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Paystack Dashboard > Settings > API Keys & Webhooks
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Create a monthly NGN plan priced at 300000 kobo (N3,000).
PAYSTACK_MONTHLY_PLAN_CODE=

# Google AI Studio API key; the model can be changed without changing source code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resend — server secrets and verified sender details
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=EA Academy <hello@updates.example.com>
EMAIL_REPLY_TO=

# Meta WhatsApp Cloud API — server secrets only
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_BROADCAST_TEMPLATE=ea_academy_broadcast
WHATSAPP_BIRTHDAY_TEMPLATE=ea_academy_birthday
WHATSAPP_TEMPLATE_LANGUAGE=en

# Generate a long random value. Used only by the scheduled worker endpoint.
AUTOMATION_SECRET=
